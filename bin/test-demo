#!/usr/bin/env bash
# End-to-end demo test script
#
# Launches the CRM demo (service + UI) and runs end-to-end tests against it
#
# Usage: ./bin/test-demo
#
# Exit codes:
#   0 - All tests passed
#   1 - Tests failed
#   2 - Setup failed

set -euo pipefail

# Configuration
SERVICE_DIR="contact-relationship-management-service-with-rust"
UI_DIR="contact-relationship-management-ui-with-svelte"
SERVICE_URL="http://localhost:1241"
UI_URL="http://localhost:5173"
WAIT_TIME=10
TEST_TIMEOUT=60

# Counters
PASSED=0
FAILED=0

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track PIDs
SERVICE_PID=""
UI_PID=""

# Cleanup function
cleanup() {
    echo ""
    echo "Cleaning up..."
    if [ -n "$SERVICE_PID" ]; then
        echo "Stopping service (PID: $SERVICE_PID)..."
        kill "$SERVICE_PID" 2>/dev/null || true
    fi
    if [ -n "$UI_PID" ]; then
        echo "Stopping UI (PID: $UI_PID)..."
        kill "$UI_PID" 2>/dev/null || true
    fi
    echo "Cleanup complete."
}

trap cleanup EXIT

# Helper function to wait for URL to be available
wait_for_url() {
    local url="$1"
    local max_retries="$2"
    local retry=0
    
    echo "Waiting for $url to be available..."
    while [ $retry -lt $max_retries ]; do
        if curl -s -o /dev/null -w "%{http_code}" "$url" | grep -q "200"; then
            echo "$url is ready!"
            return 0
        fi
        sleep 1
        retry=$((retry + 1))
        echo -n "."
    done
    echo ""
    echo "Timeout waiting for $url"
    return 1
}

# Helper function to test API endpoint
test_api_endpoint() {
    local endpoint="$1"
    local expected_status="$2"
    local description="$3"
    
    echo -n "Testing $description... "
    if curl -s -o /dev/null -w "%{http_code}" "${SERVICE_URL}${endpoint}" | grep -q "${expected_status}"; then
        echo "${GREEN}PASS${NC}"
        PASSED=$((PASSED + 1))
        return 0
    else
        echo "${RED}FAIL${NC}"
        FAILED=$((FAILED + 1))
        return 1
    fi
}

# Helper function to test UI endpoint
test_ui_endpoint() {
    local endpoint="$1"
    local expected_content="$2"
    local description="$3"
    
    echo -n "Testing $description... "
    if curl -s "${UI_URL}${endpoint}" | grep -q "${expected_content}"; then
        echo "${GREEN}PASS${NC}"
        PASSED=$((PASSED + 1))
        return 0
    else
        echo "${RED}FAIL${NC}"
        FAILED=$((FAILED + 1))
        return 1
    fi
}

# Main execution
echo "========================================="
echo "End-to-End Demo Test"
echo "========================================="
echo ""

# Step 1: Start the service
echo "Step 1: Starting CRM service..."
echo "-----------------------------------------"
cd "$SERVICE_DIR"
if ! cargo build --release 2>&1 | tail -5; then
    echo "${RED}Failed to build service${NC}"
    exit 2
fi

# Start service in background
./target/release/contact-relationship-management db migrate > /tmp/service.log 2>&1 || true
./target/release/contact-relationship-management task seed > /tmp/service.log 2>&1 || true
./target/release/contact-relationship-management start >> /tmp/service.log 2>&1 &
SERVICE_PID=$!
echo "Service started (PID: $SERVICE_PID)"

# Wait for service to be ready
sleep 5
if ! wait_for_url "$SERVICE_URL/health" 30; then
    echo "${RED}Service failed to start${NC}"
    cat /tmp/service.log | tail -20
    exit 2
fi

# Step 2: Start the UI
echo ""
echo "Step 2: Starting CRM UI..."
echo "-----------------------------------------"
cd "../$UI_DIR"
if [ ! -f "package.json" ]; then
    echo "UI package.json not found, skipping UI"
    UI_PID=""
else
    if ! pnpm install > /tmp/ui.log 2>&1; then
        echo "${YELLOW}Warning: Failed to install UI dependencies${NC}"
        UI_PID=""
    else
        pnpm dev >> /tmp/ui.log 2>&1 &
        UI_PID=$!
        echo "UI started (PID: $UI_PID)"
        
        # Wait for UI to be ready
        sleep 5
        if ! wait_for_url "$UI_URL" 30; then
            echo "${YELLOW}Warning: UI failed to start${NC}"
            cat /tmp/ui.log | tail -20
            UI_PID=""
        fi
    fi
fi

# Step 3: Run end-to-end tests
echo ""
echo "Step 3: Running end-to-end tests..."
echo "-----------------------------------------"
echo ""

# Test service health endpoint
test_api_endpoint "/health" "200" "Service health check"

# Test service root endpoint
test_api_endpoint "/" "200" "Service root endpoint"

# Test API documentation endpoint
test_api_endpoint "/api" "200" "API endpoint"

# Test contacts endpoint (if auth is disabled)
test_api_endpoint "/api/v1/contacts" "401" "Contacts endpoint (expecting 401 without auth)"

# Test UI endpoints (if UI is running)
if [ -n "$UI_PID" ]; then
    test_ui_endpoint "/" "CRM" "UI root page"
fi

# Step 4: Additional API tests
echo ""
echo "Step 4: Additional API tests..."
echo "-----------------------------------------"
echo ""

# Test settings endpoint
test_api_endpoint "/api/v1/settings" "401" "Settings endpoint"

# Test version endpoint
test_api_endpoint "/api/version" "200" "Version endpoint"

# Test metrics endpoint (if prometheus is enabled)
test_api_endpoint "/metrics" "200" "Metrics endpoint"

# Final summary
echo ""
echo "========================================="
echo "Test Summary"
echo "========================================="
echo "Passed: $PASSED"
echo "Failed: $FAILED"
echo ""

if [ $FAILED -gt 0 ]; then
    echo "${RED}Some tests failed!${NC}"
    exit 1
else
    echo "${GREEN}All tests passed!${NC}"
    exit 0
fi
