# Makefile for contact-relationship-management-ui-with-svelte
# Provides a convenient 'demo' target to install dependencies and start the dev server

.PHONY: demo
demo:
	@echo "Installing dependencies..."
	pnpm install
	@echo "Starting development server..."
	pnpm dev

.PHONY: test
test:
	@echo "Running UI tests..."
	pnpm test
	@echo "UI tests complete."
