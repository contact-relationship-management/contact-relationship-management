# Contact Relationship Management Service API base, ending in /api (a
# trailing slash is dropped). The BFF proxy sends /api/proxy/<path> to
# <CRM_API_URL>/<path>. Server-side only — read by src/lib/server/config.ts
# and never reaches the browser bundle. 5150 is the loco.rs default port the
# service binds in dev.
CRM_API_URL=http://localhost:5150/api

# Authentication Service base URL (no trailing slash). Server-side only.
# Used for the session -> PASETO exchange and the magic-link
# request/verify flow (/signin, /verify).
AUTH_API_URL=http://localhost:5150

# The guided tour: signing in as example@example.com opens the whole app on
# fictitious data held in the UI server (no service call, nothing stored).
# On by default; set to "off" for a deployment that must not offer it.
# CRM_DEMO_TOUR=off

# Opt-in "Sign in with SSO" (OIDC via the authentication service). Public
# (read by the sign-in page and /signin/sso). Set to "true" ONLY when the
# paired auth-service has its AUTH_OIDC_* variables configured; unset hides
# the link and makes /signin/sso 404. Magic link stays the default.
# PUBLIC_OIDC_SIGNIN_ENABLED=true
