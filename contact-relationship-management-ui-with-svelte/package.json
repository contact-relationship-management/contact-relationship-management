{
  "name": "contact-relationship-management-ui-with-svelte",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "SvelteKit front-end for the Contact Relationship Management Service (Main X Index): sales, marketing, customer support and analytics.",
  "license": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts \"*.{ts,js}\"",
    "lint": "prettier --check src tests scripts \"*.{ts,js}\" && eslint .",
    "api:types": "openapi-typescript \"${OPENAPI:?set OPENAPI to the service openapi.json}\" -o src/lib/api/schema.d.ts",
    "test:live": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@lilydesignsystem/svelte-calendar": "0.7.0",
    "@lilydesignsystem/svelte-data-grid": "0.11.0",
    "@lilydesignsystem/svelte-gantt-chart": "0.8.0",
    "@lilydesignsystem/svelte-headless": "0.6.1",
    "@lilydesignsystem/svelte-kanban-board": "0.8.1",
    "@lilydesignsystem/svelte-link-picker": "0.2.0",
    "@lilydesignsystem/svelte-locale-picker": "0.3.1",
    "@lilydesignsystem/svelte-locale-translations": "0.3.0",
    "@lilydesignsystem/svelte-picker-bar": "0.4.0",
    "@lilydesignsystem/svelte-search-picker": "0.2.0",
    "@lilydesignsystem/svelte-share-picker": "0.3.0",
    "@lilydesignsystem/svelte-text-size-picker": "0.3.0",
    "@lilydesignsystem/svelte-theme-picker": "0.3.0",
    "@lilydesignsystem/themes": "0.6.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
