{
  "name": "contact-relationship-management-ui-with-svelte",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "SvelteKit front-end for the Contact Relationship Management Service (Main X Index): sales, marketing, customer support and analytics.",
  "license": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only OR OGL-UK-3.0 OR CC-BY-SA-4.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts \"*.{ts,js}\"",
    "lint": "prettier --check src tests scripts \"*.{ts,js}\" && eslint .",
    "api:types": "openapi-typescript \"${OPENAPI:?set OPENAPI to the service openapi.json}\" -o src/lib/api/schema.d.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "size": "node scripts/bundle-size.mjs",
    "perf:pages": "playwright test --config playwright.perf.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@lilydesignsystem/svelte-calendar": "0.7.2",
    "@lilydesignsystem/svelte-data-grid": "0.11.2",
    "@lilydesignsystem/svelte-gantt-chart": "0.8.2",
    "@lilydesignsystem/svelte-headless": "0.13.1",
    "@lilydesignsystem/svelte-kanban-board": "0.8.3",
    "@lilydesignsystem/svelte-link-picker": "0.2.2",
    "@lilydesignsystem/svelte-locale-picker": "0.3.3",
    "@lilydesignsystem/svelte-locale-translations": "0.6.0",
    "@lilydesignsystem/svelte-picker-bar": "0.10.0",
    "@lilydesignsystem/svelte-search-picker": "0.2.2",
    "@lilydesignsystem/svelte-share-picker": "0.3.2",
    "@lilydesignsystem/svelte-text-size-picker": "0.3.2",
    "@lilydesignsystem/svelte-theme-picker": "0.5.0",
    "@lilydesignsystem/themes": "0.9.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
