# Hardened image for the CRM UI / BFF (CRM-T35).
#   podman build -f Containerfile -t crm-ui .
# Runtime: node on distroless, non-root, no shell, read-only-rootfs compatible.

FROM docker.io/library/node:26-bookworm-slim@sha256:298992629d69bbd5b2b03ad57094d8e4fcb3a8eeb7c4e25d29de656519568913 AS build
WORKDIR /src
# Node 25+ no longer ships corepack, so install the pinned pnpm with npm.
RUN npm install --global pnpm@11.0.8
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build && pnpm prune --prod

FROM gcr.io/distroless/nodejs24-debian12:nonroot@sha256:14d42e2511532589a7c7e01a753667a74fcc96266e137e8125006b87b0c32d0a
# Build arguments from the release workflow (scripts/release-version.sh gives
# VERSION, checked against the manifest and the tag); the defaults mark a
# local build.
ARG VERSION=0.0.0-dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Contact Relationship Management web UI" \
      org.opencontainers.image.source="https://github.com/contact-relationship-management/contact-relationship-management" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
WORKDIR /app
COPY --from=build /src/build ./build
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/package.json ./
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
USER nonroot:nonroot
EXPOSE 3000
ENTRYPOINT ["/nodejs/bin/node", "build"]
