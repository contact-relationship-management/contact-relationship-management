{
  "db_name": "PostgreSQL",
  "query": "SELECT pid, subject_kind, subject_pid, name, content_type, size_bytes, sha256, uploaded_by, created_at FROM attachments WHERE ((subject_kind = 'contact' AND (subject_pid = $1 OR subject_pid IN (SELECT pid FROM contacts WHERE merged_into_pid = $1))) OR (subject_kind = 'lead' AND subject_pid IN (SELECT pid FROM leads WHERE contact_pid = $1))) /* whatever deleted_at holds: a merged duplicate and a lead are the subject's */ ORDER BY id",
