{
  "db_name": "PostgreSQL",
  "query": "SELECT k.article_pid AS pid, COALESCE(a.title, '(deleted article)') AS \"title!\", SUM(k.views)::bigint AS \"views!\", SUM(k.helpful_yes)::bigint AS \"yes!\", SUM(k.helpful_no)::bigint AS \"no!\" FROM kb_daily k LEFT JOIN articles a ON a.pid = k.article_pid AND a.deleted_at IS NULL WHERE k.day BETWEEN $1 AND $2 AND k.article_pid <> $3 GROUP BY k.article_pid, a.title HAVING SUM(k.views) > 0 ORDER BY 3 DESC, 2 LIMIT 10",
