{
  "db_name": "PostgreSQL",
  "query": "SELECT pid, amount_minor, currency, source_campaign_pid, created_at, closed_at AS \"closed_at!\", (closed_at AT TIME ZONE $4)::date AS \"closed_on!\" FROM deals WHERE won AND deleted_at IS NULL AND closed_at IS NOT NULL AND ($1::date IS NULL OR (closed_at AT TIME ZONE $4)::date >= $1::date) AND ($2::date IS NULL OR (closed_at AT TIME ZONE $4)::date <= $2::date) ORDER BY closed_at DESC, id LIMIT $3",
