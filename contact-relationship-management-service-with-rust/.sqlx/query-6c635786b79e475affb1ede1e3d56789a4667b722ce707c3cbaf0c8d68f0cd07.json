  "query": "SELECT d.attempts, d.event_id, d.subscription_id AS sub, s.pid AS sub_pid, s.url, s.secret, s.previous_secret, s.previous_secret_expires_at, o.entity AS \"entity?\", o.kind AS \"kind?\", o.entity_pid AS \"entity_pid?\", o.occurred_at AS \"occurred_at?\" FROM webhook_deliveries d JOIN webhook_subscriptions s ON s.id = d.subscription_id LEFT JOIN event_outbox o ON o.event_id = d.event_id WHERE d.id = $1 AND d.status = 'pending'",
