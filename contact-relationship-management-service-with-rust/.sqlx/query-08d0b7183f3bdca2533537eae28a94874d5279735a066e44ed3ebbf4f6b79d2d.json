  "query": "SELECT m.ticket_pid, m.from_ref, m.to_ref, m.via, m.reason, m.actor_ref, m.created_at FROM ticket_movements m JOIN tickets t ON t.pid = m.ticket_pid /* deleted_at set or not: a soft-deleted ticket is still the subject's */ WHERE t.contact_pid = $1 ORDER BY t.id, m.id",
