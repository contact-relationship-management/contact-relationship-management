  "query": "SELECT created_at, updated_at, id, pid, title, body, keywords, status, version, deleted_at AS \"deleted_at: DateTimeWithTimeZone\" FROM articles WHERE deleted_at IS NULL AND ($1::text IS NULL OR lower(title) LIKE $1 OR lower(coalesce(keywords, '')) LIKE $1) ORDER BY id LIMIT $2 OFFSET $3",
