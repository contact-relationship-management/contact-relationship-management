  "query": "SELECT q.pid, q.owner_ref, q.period_from, q.period_to, trim(q.currency) AS \"currency!\", q.amount_minor, p.name AS \"plan_name?\", p.tiers AS \"plan_tiers?\" FROM quotas q LEFT JOIN commission_plans p ON p.pid = q.plan_pid WHERE q.period_from <= $1 AND q.period_to >= $1 AND ($2::text IS NULL OR q.owner_ref = $2) ORDER BY q.owner_ref, q.currency LIMIT $3",
