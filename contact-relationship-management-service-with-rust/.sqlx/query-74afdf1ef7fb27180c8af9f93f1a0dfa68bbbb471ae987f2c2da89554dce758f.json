  "query": "WITH p AS ( INSERT INTO commission_plans (pid, name, tiers, set_by) VALUES ($1, $2, $3::jsonb, $4) ON CONFLICT ((lower(name))) DO UPDATE SET name = EXCLUDED.name, tiers = EXCLUDED.tiers, set_by = EXCLUDED.set_by, updated_at = now() RETURNING * ) SELECT p.pid AS \"pid!\", p.name AS \"name!\", p.tiers AS \"tiers!\", p.set_by AS \"set_by!\", (SELECT count(*) FROM quotas q WHERE q.plan_pid = p.pid) AS \"in_use!\" FROM p",
