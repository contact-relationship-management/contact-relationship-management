  "query": "SELECT d.pid, trim(d.currency) AS \"currency!\", d.amount_minor, d.owner_ref FROM deals d WHERE d.won AND d.deleted_at IS NULL AND d.closed_at IS NOT NULL AND (d.closed_at AT TIME ZONE $4)::date BETWEEN $2 AND $3 AND (d.owner_ref = $1 OR EXISTS (SELECT 1 FROM deal_splits s WHERE s.deal_pid = d.pid AND s.owner_ref = $1))",
