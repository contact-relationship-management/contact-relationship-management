{
  "db_name": "PostgreSQL",
  "query": "SELECT a.pid, a.subject_kind, a.subject_pid, a.assignee_ref AS \"assignee_ref!\", (extract(epoch FROM a.remind_at) * 1000000)::bigint AS \"micros!\" FROM activities a WHERE a.kind = 'task' AND a.done = FALSE AND a.deleted_at IS NULL AND a.assignee_ref IS NOT NULL AND a.remind_at <= now() AND NOT EXISTS (SELECT 1 FROM notifications n WHERE n.kind = 'task_reminder' AND n.source_pid = a.pid AND n.recipient_ref = a.assignee_ref AND n.source_key = (extract(epoch FROM a.remind_at) * 1000000)::bigint::text) ORDER BY a.remind_at LIMIT $1",
