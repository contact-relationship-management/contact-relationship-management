# Hardened image for the CRM service (CRM-T35).
#   podman build -f Containerfile -t crm-service .   (run in this directory)
# Runtime: distroless, non-root, no shell, read-only-rootfs compatible.
# Pin the base images by digest in your registry mirror before release.

FROM docker.io/library/rust:1.99-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked --features keycloak \
 && strip target/release/contact-relationship-management-service

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
COPY --from=build /src/target/release/contact-relationship-management-service /app/crm-service
COPY --from=build /src/config /app/config
WORKDIR /app
ENV LOCO_ENV=production \
    CRM_REQUIRE_AUTH=1 \
    PORT=5150
USER nonroot:nonroot
EXPOSE 5150
# The binary refuses to start in production without authentication (CRM-T30).
# Secrets (DATABASE_URL, token keys) come from the orchestrator, never the image.
ENTRYPOINT ["/app/crm-service", "start"]
